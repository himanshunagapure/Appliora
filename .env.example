# Gemini API Key (Required for resume parsing, scoring, and tailoring)
# Get a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
LLM_MAX_RETRIES=2

# Database configuration
# Defaults to SQLite in the project directory
DATABASE_URL=sqlite:///./jobapplypro.db

# Optional: Pinecone API Key (unused — Phase 4 uses local ChromaDB/ONNX embeddings)
PINECONE_API_KEY=

# Phase 4 — Scoring (combined score is 1–10)
# Jobs at/above SCORE_THRESHOLD proceed to resume tailoring.
SCORE_THRESHOLD=6.0
SCORE_SEMANTIC_WEIGHT=0.4
SCORE_LLM_WEIGHT=0.6

# Phase 7 — Browser automation
# AUTO_SUBMIT=true: pipeline fills the form and clicks Submit.
# Jobs that hit CAPTCHA / OTP / payment stay manual_review.
# AUTO_SUBMIT=false: fill only, never click Submit.
AUTO_SUBMIT=true
BROWSER_HEADLESS=true
# Tier 2 (browser-use) defaults to headed — CAPTCHA is much worse headless.
# TIER2_HEADLESS=false
# Optional persistent Chromium profile (needed for LinkedIn Easy Apply login):
# BROWSER_USER_DATA_DIR=/home/user/.jobapplypro-browser
# Tier 2 (browser-use) MUST use a separate profile — sharing the Playwright dir
# locks Chrome and the agent times out on BrowserStartEvent:
# TIER2_USER_DATA_DIR=output/browser_tier2_profile
# Per-job cookie/localStorage snapshots (dry-run → submit continuity):
# BROWSER_STATE_DIR=output/browser_state
# When headed and LinkedIn asks you to sign in, keep the window open this long:
BROWSER_LOGIN_WAIT_SECONDS=180
# Sign in automatically when the persistent Chrome profile is logged out:
# LINKEDIN_EMAIL=you@example.com
# LINKEDIN_PASSWORD=
# NAUKRI_EMAIL=you@example.com
# NAUKRI_PASSWORD=
# INDEED_EMAIL=you@example.com
# INDEED_PASSWORD=
# Use installed Chrome instead of Playwright's Chromium (helps Workday login):
# BROWSER_CHANNEL=chrome
FORM_MIN_CONFIDENCE=0.55

# Phase 7 Tier 2 — browser-use generalized apply agent (ADR-002)
# Uses GEMINI_API_KEY via ChatGoogle unless TIER2_LLM_MODEL / GOOGLE_API_KEY override.
TIER2_ENABLED=true
# Cap how many unmatched/Lever/etc. jobs the agent may attempt per apply run.
# Jobs beyond this stay cover_letter_ready (retry next run) — they are not
# dumped into manual_review.
TIER2_MAX_JOBS_PER_RUN=15
TIER2_MAX_AGENT_STEPS=50
# Optional override (defaults to GEMINI_MODEL):
# TIER2_LLM_MODEL=gemini-2.5-flash

# Phase 11 — proxy rotation for JobSpy (optional; comma-separated host:port)
# PROXY_URLS=user:pass@host:3128,host2:8080
# PROXY_FILE=config/proxies.txt

# Phase 11 — alerts when newly scored jobs are ≥ SCORE_THRESHOLD (optional)
# NOTIFY_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# NOTIFY_EMAIL_TO=you@example.com
# NOTIFY_EMAIL_FROM=jobapplypro@example.com
# NOTIFY_SMTP_HOST=smtp.example.com
# NOTIFY_SMTP_PORT=587
# NOTIFY_SMTP_USER=
# NOTIFY_SMTP_PASSWORD=

# Phase 11 — local dashboard (python cli.py dashboard)
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8765
